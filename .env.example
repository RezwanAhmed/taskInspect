# TaskInspect — environment variables
#
# Copy this file to `.env` (never commit `.env`) and change the values.
# The backend reads `.env` from the repository root or from `backend/`;
# in Docker and in the cloud the same names are set as real environment
# variables, which take priority over `.env`.

# ---------- Application ----------
# Spring profile: dev (local development) or prod
SPRING_PROFILES_ACTIVE=dev
# HTTP port of the backend API
SERVER_PORT=8080

# ---------- Database (PostgreSQL, used from task 2.4) ----------
DB_HOST=localhost
# Port on your machine. On Windows, Hyper-V may reserve 5432 ("bind: access
# forbidden"); check with `netsh int ipv4 show excludedportrange protocol=tcp`
# and use a free port such as 15432 instead.
DB_PORT=5432
DB_NAME=taskinspect
DB_USERNAME=taskinspect
# Local development password only — use a strong secret everywhere else
DB_PASSWORD=change-me

# ---------- First administrator ----------
# Created on startup if no administrator exists yet (password: at least
# 12 characters). You can remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_FULL_NAME=Administrator
