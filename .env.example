# TaskInspect — environment variables
#
# Copy this file to `.env` (never commit `.env`) and change the values.
# The backend reads `.env` from the repository root or from `backend/`;
# in Docker and in the cloud the same names are set as real environment
# variables, which take priority over `.env`.

# ---------- Application ----------
# Spring profile: dev (local development) or prod
SPRING_PROFILES_ACTIVE=dev
# HTTP port of the backend API
SERVER_PORT=8080

# ---------- Database (PostgreSQL, used from task 2.4) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskinspect
DB_USERNAME=taskinspect
# Local development password only — use a strong secret everywhere else
DB_PASSWORD=change-me
